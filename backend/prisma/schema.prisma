// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider              = "prisma-client"
  output                = "../generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item{
  id    String  @id @default(cuid())
  audioPath String?
  originalFileName String
  pairedTranscriptFileName String?
  status ItemStatus @default(PENDING)

  durationSeconds Float?
  sampleRate  Int?
  channels  Int?
  bitDepth  Int?
  distanceEstimate         String?   // "close" | "medium" | "far"
  distanceEstimateOverride String?
  speechRateWpm            Float?
  speechRateWpmOverride    Float?

  originalTranscript  String?
  correctedTranscript  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spans AnnotationSpan[]

  @@unique([originalFileName])
}

enum ItemStatus {
  PENDING
  IN_PROGRESS
  DONE
  REJECTED // for audio files less than 15s duration
}

model AnnotationSpan {
  id          String   @id @default(cuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  type        SpanType
  startOffset Int
  endOffset   Int

  attributes  Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([itemId])
}

enum SpanType {
  NUMBER
  FORMATTING_COMMAND
  SPELLED_OUT
  NAMED_ENTITY
  MEDICAL_TERM
  MEASUREMENT
}
